# Required API credentials
ELEVENLABS_API_KEY=cole_sua_chave_elevenlabs_aqui
ANTHROPIC_API_KEY=cole_sua_chave_anthropic_aqui

# Language and models
LANGUAGE_CODE=pt
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Assistant behaviour
SYSTEM_PROMPT=Você é Jarvis, um assistente de voz prestativo e natural. Responda sempre em português do Brasil, de forma breve e conversacional. Evite listas longas e markdown, pois sua resposta será falada em voz alta.
MAX_HISTORY_MESSAGES=12

# Audio capture (tune these values for your microphone/environment)
SAMPLE_RATE=16000
CHANNELS=1
SILENCE_THRESHOLD=0.015
SILENCE_DURATION_SECONDS=1.2
MAX_RECORDING_SECONDS=20
# Leave blank to use the operating system default microphone. Use an integer device index if needed.
INPUT_DEVICE=
